{
  "experiment_id": "laptop-fedavg-mlp",
  "framework": "flower",
  "algorithm": "FedAvg",
  "model": {
    "schema_version": "flow-v2",
    "transform": "flow-v2-fixed-log-v1",
    "features": ["protocol", "duration_s", "pkts_toserver", "pkts_toclient", "bytes_toserver", "bytes_toclient", "mean_packet_bytes", "response_packet_ratio", "duration_le_1us"],
    "input_width": 13,
    "hidden_layer_sizes": [32, 16],
    "output_width": 1,
    "activation": "relu",
    "output_activation": "sigmoid",
    "dtype": "float64",
    "threshold": 0.5,
    "labels": {"benign": 0, "attack": 1}
  },
  "training": {
    "seed": 20261018,
    "initialization": "fresh_shared_weights",
    "rounds": 50,
    "smoke_rounds": 1,
    "pilot_rounds": 5,
    "local_epochs": 1,
    "solver": "adam",
    "learning_rate_init": 0.001,
    "alpha": 0.0001,
    "batch_size": 256,
    "optimizer_state": "reset_each_round",
    "required_client_ids": ["A", "B", "C"],
    "require_all_clients": true,
    "aggregation_weight": "num_train_rows",
    "checkpoint_selection": "mean_node_validation_balanced_accuracy",
    "checkpoint_tie_break": "earliest_round",
    "test_during_training": false
  },
  "deployment": {
    "compose_project": "ddos-fl-laptop",
    "profile": "fl",
    "network_name": "ddos-fl-laptop_federation",
